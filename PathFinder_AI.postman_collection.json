{
  "info": {
    "name": "PathFinder AI API Collection",
    "description": "Complete REST API collection for testing PathFinder AI Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Demo Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@pathfinder.ai\",\n  \"password\": \"Demo@123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Get Learning Path",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "http://localhost:5000/api/learning-paths",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "learning-paths"]
        }
      }
    },
    {
      "name": "AI Chat Assistant",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Why am I learning Node.js before Express?\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/ai/chat",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "ai", "chat"]
        }
      }
    }
  ]
}
